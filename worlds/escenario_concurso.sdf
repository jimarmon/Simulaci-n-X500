      </link>
    </model>

    <!-- Figura 4: Arco alto con barra roja superior (Y = 10.0) -->
    <model name="figura_arco_alto">
      <static>true</static>
      <pose>3.5 10.0 0 0 0 0</pose>
      <link name="poste_izq">
        <pose>-0.75 0 0.99 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>1.98</length></cylinder></geometry></collision>
