        <visual name="vis"><geometry><box><size>0.2 0.05 0.5</size></box></geometry><material><ambient>0.85 0.65 0.45 1</ambient><diffuse>0.85 0.65 0.45 1</diffuse></material></visual>
      </link>
      <link name="panel_madera_der">
        <pose>0.65 0 1.6 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 0.05 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 0.05 0.5</size></box></geometry><material><ambient>0.85 0.65 0.45 1</ambient><diffuse>0.85 0.65 0.45 1</diffuse></material></visual>
      </link>
      <link name="panel_madera_rojo_sup">
        <pose>0.35 0 1.825 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.4 0.05 0.05</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.05 0.05</size></box></geometry><material><ambient>0.85 0.65 0.45 1</ambient><diffuse>0.85 0.65 0.45 1</diffuse></material></visual>
      </link>
      <link name="panel_madera_rojo_inf">
        <pose>0.35 0 1.375 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.4 0.05 0.05</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.05 0.05</size></box></geometry><material><ambient>0.85 0.65 0.45 1</ambient><diffuse>0.85 0.65 0.45 1</diffuse></material></visual>
      </link>

      <!-- MARCO AZUL (Sobrepuesto frontalmente Y=-0.02, Luz interior 600x500mm) -->
      <link name="marco_azul_izq">
        <pose>-0.67 -0.02 1.6 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.04 0.03 0.5</size></box></geometry><material><ambient>0 0 0.9 1</ambient><diffuse>0 0 0.9 1</diffuse></material></visual>
      </link>
      <link name="marco_azul_der">
        <pose>-0.03 -0.02 1.6 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.04 0.03 0.5</size></box></geometry><material><ambient>0 0 0.9 1</ambient><diffuse>0 0 0.9 1</diffuse></material></visual>
      </link>
      <link name="marco_azul_sup">
        <pose>-0.35 -0.02 1.87 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.68 0.03 0.04</size></box></geometry><material><ambient>0 0 0.9 1</ambient><diffuse>0 0 0.9 1</diffuse></material></visual>
      </link>
      <link name="marco_azul_inf">
        <pose>-0.35 -0.02 1.33 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.68 0.03 0.04</size></box></geometry><material><ambient>0 0 0.9 1</ambient><diffuse>0 0 0.9 1</diffuse></material></visual>
      </link>

      <!-- MARCO ROJO (Sobrepuesto frontalmente Y=-0.02, Luz interior 400x400mm) -->
      <link name="marco_rojo_izq">
        <pose>0.13 -0.02 1.6 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.04 0.03 0.4</size></box></geometry><material><ambient>0.9 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse></material></visual>
      </link>
      <link name="marco_rojo_der">
        <pose>0.57 -0.02 1.6 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.04 0.03 0.4</size></box></geometry><material><ambient>0.9 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse></material></visual>
      </link>
      <link name="marco_rojo_sup">
        <pose>0.35 -0.02 1.82 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.48 0.03 0.04</size></box></geometry><material><ambient>0.9 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse></material></visual>
      </link>
      <link name="marco_rojo_inf">
        <pose>0.35 -0.02 1.38 0 0 0</pose>
